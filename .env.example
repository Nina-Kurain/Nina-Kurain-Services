# Environment Configuration Example
# Copy this file to .env or configure in Cloudflare dashboard / CI secrets
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

APP_ENV=production
APP_URL=https://ninakurainservices.in
ADMIN_EMAIL=contact@ninakurainservices.in
ADMIN_PASSWORD_HASH=replace_with_secure_hash
MEDIA_SIGNING_SECRET=replace_with_random_32_char_hex_secret
JWT_SECRET=replace_with_random_32_char_hex_secret

# Google Drive API (For secure media syncing)
GOOGLE_DRIVE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=replace_with_aes_256_encryption_key

# Payment & Mail Gateways
ENABLE_TEST_ACCOUNTS=false
PAYMENT_MODE=live
MAIL_API_KEY=replace_with_mail_gateway_key
MAIL_FROM="Nina Kurain Official <contact@ninakurainservices.in>"
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
CRON_SECRET=replace_with_random_secret_token

# Cloudflare D1 Database & Storage
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_NAME=replace_with_database_name
CLOUDFLARE_D1_DATABASE_ID=replace_with_d1_database_id

# Public Verification & Integrations (Non-secret)
PINTEREST_SITE_VERIFICATION=your_pinterest_verification_token
GOOGLE_ADSENSE_CLIENT=ca-pub-your_adsense_id

# Safety screening (fail-closed quarantine when omitted)
MODERATION_API_URL=https://your-moderation-service.example/api/screen
MODERATION_API_KEY=replace_with_moderation_service_key

# AI adapters are intentionally server-side only. Configure provider-specific
# adapters before enabling production generation UI.
AI_OPENAI_ADAPTER_URL=https://your-openai-adapter.example/generate
AI_GEMINI_ADAPTER_URL=https://your-gemini-adapter.example/generate
AI_KLING_ADAPTER_URL=https://your-kling-adapter.example/generate
